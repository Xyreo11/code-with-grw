# --- Database (docker compose publishes postgres on 5433; 5432 is taken on this host) ---
DATABASE_URL="postgresql://sitrep:sitrep@localhost:5433/sitrep?schema=public"

# --- Redis (published on 6380 to avoid clashing with any local redis) ---
REDIS_URL="redis://localhost:6380"

# --- Auth ---
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Market data ---
# FIXTURE_MODE=1 runs the entire app from committed fixtures with NO network and NO API keys.
# This is the default for reviewers: clone, docker compose up, seed, done.
FIXTURE_MODE=1

# Twelve Data — PRIMARY bar source (history + daily updates).
# Free: 800 req/day, 8 req/min, 5000 points per request, full daily history.
# https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=""

# Tiingo — SECOND bar source, used only for cross-source reconciliation.
# Free: ~50 symbols/hour, 500/month, 30+ years of EOD history. No card.
# https://www.tiingo.com/
TIINGO_API_KEY=""

# Finnhub — earnings calendar + company news only.
# Free: 60 req/min. NOTE: /stock/candle is premium-gated on free keys, which is
# why bars come from Twelve Data rather than Finnhub.
FINNHUB_API_KEY=""

# Historical note: Stooq was the original keyless history source. It now serves a
# JavaScript proof-of-work bot challenge instead of CSV, so it was dropped.

# --- Ops ---
# Shared secret guarding the ingest cron route.
CRON_SECRET="change-me"
